            >
              +{amount}
            </Button>
          ))}
        </div>

        <Button
          variant="contained"
          onClick={handleCardDraw}
          disabled={selectedIds.length === 0}
          style={{
            ...buttonStyle,
            background: selectedIds.length > 0 ? '#ff5722' : '#ccc',
            color: 'white'
          }}
