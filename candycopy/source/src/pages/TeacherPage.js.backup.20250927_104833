  const handleTokenChange = async (studentId, delta) => {
    try {
      const studentRef = doc(db, 'students', studentId);
      const studentDoc = await getDoc(studentRef);
      
      if (studentDoc.exists()) {
        const currentTokens = studentDoc.data().friendTokens || 10;
        const newTokens = Math.max(0, Math.min(10, currentTokens + delta));
        
        await updateDoc(studentRef, {
          friendTokens: newTokens
        });
      }
    } catch (error) {
      console.error('토큰 업데이트 오류:', error);
    }
  };

  const handleMessageSend = async () => {
    if (!messageText.trim() || selectedIds.length === 0) return;

    try {
      const messageData = {
        text: messageText,
        timestamp: Date.now(),
        type: 'teacher_message',
        sender: 'teacher'
      };

      for (const studentId of selectedIds) {
        const studentRef = doc(db, 'students', studentId);
        await updateDoc(studentRef, {
          messages: arrayUnion(messageData)
        });
      }

      setMessageText('');
      setSelectedIds([]);
      setShowMessageModal(false);
    } catch (error) {
      console.error('메시지 전송 오류:', error);
    }
  };

  const handleQuestSend = async () => {
    if (!questText.trim() || selectedIds.length === 0) return;

    try {
      for (const studentId of selectedIds) {
        const questData = {
          id: Date.now() + Math.random(),
          text: questText,
          studentId: studentId,
          status: 'pending',
          createdAt: Date.now(),
          exp: questExp
        };

        await addDoc(collection(db, 'quests'), questData);
      }

      setQuestText('');
      setSelectedIds([]);
      setShowQuestModal(false);
    } catch (error) {
      console.error('퀘스트 전송 오류:', error);
    }
  };

  const handleExpGive = async (amount) => {
    if (selectedIds.length === 0) return;

    try {
      const newExpEffectIds = [];
      const newLevelUpEffectIds = [];

      for (const studentId of selectedIds) {
        const student = students.find(s => s.id === studentId);
        if (!student) continue;

        const newExp = (student.exp || 0) + amount;
        const currentLevel = student.level || 1;
        const newLevel = Math.min(Math.floor(newExp / 100) + 1, 6);

        newExpEffectIds.push(studentId);
        if (newLevel > currentLevel) {
          newLevelUpEffectIds.push(studentId);
        }

        const studentRef = doc(db, 'students', studentId);
        await updateDoc(studentRef, {
          exp: newExp,
          level: newLevel
        });
      }

      setExpEffectIds(newExpEffectIds);
      if (newLevelUpEffectIds.length > 0) {
        setLevelUpEffectIds(newLevelUpEffectIds);
      }

      setSelectedIds([]);
    } catch (error) {
      console.error('경험치 지급 오류:', error);
    }
  };

  const handleQuestAction = async (questId, action, student, quest) => {
    try {
      const questRef = doc(db, 'quests', questId);

      if (action === 'approve') {
        // 퀘스트 승인
        await updateDoc(questRef, { status: 'approved' });

        // 학생에게 경험치 지급
        const studentRef = doc(db, 'students', quest.studentId);
        const studentSnapshot = await getDoc(studentRef);
        
        if (studentSnapshot.exists()) {
          const studentData = studentSnapshot.data();
          const newExp = (studentData.exp || 0) + (quest.exp || 10);
          const currentLevel = studentData.level || 1;
          const newLevel = Math.min(Math.floor(newExp / 100) + 1, 6);

          await updateDoc(studentRef, {
            exp: newExp,
            level: newLevel
          });

          // 시각 효과 설정
          setQuestActionStudent(student.name);
          setQuestActionQuest(quest.text);
          setExpEffectIds([quest.studentId]);
          
          if (newLevel > currentLevel) {
            setLevelUpEffectIds([quest.studentId]);
          }

          setQuestResultEffect('승인됨');
        }
      } else if (action === 'reject') {
        // 퀘스트 거절
        await updateDoc(questRef, { 
          status: 'rejected',
          rejectReason: rejectReason 
        });

        setQuestActionStudent(student.name);
        setQuestActionQuest(quest.text);
        setQuestResultEffect('거절됨');
        setRejectReason('');
      }

      // 대기 중인 요청 목록 새로고침
      const questCollection = collection(db, 'quests');
      const q = query(questCollection, orderBy('createdAt', 'desc'));
      const snapshot = await getDocs(q);
      
      const pendingQuests = snapshot.docs
        .map(doc => ({ id: doc.id, ...doc.data() }))
        .filter(quest => quest.status === 'pending');
      
      setPendingRequests(pendingQuests);
      setSelectedRequest(null);

    } catch (error) {
      console.error('퀘스트 처리 오류:', error);
    }
  };

  const handleCreateBoard = async () => {
    if (!newBoardTitle.trim()) return;

    try {
