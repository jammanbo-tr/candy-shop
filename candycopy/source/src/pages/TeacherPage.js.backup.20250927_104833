            isSelected={selectedIds.includes(student.id)}
            onSelect={(id) => {
              setSelectedIds(prev => 
                prev.includes(id) 
                  ? prev.filter(sid => sid !== id)
                  : [...prev, id]
              );
            }}
            showExpEffect={expEffectIds.includes(student.id)}
            showLevelUpEffect={levelUpEffectIds.includes(student.id)}
            cardDrawResult={cardDrawResults[student.id]}
            onJournalView={() => handleJournalView(student)}
            onTokenChange={handleTokenChange}
          />
        ))}
      </div>

      {/* 알림 모달 */}
      {showTeacherAlarm && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            maxWidth: '800px',
            maxHeight: '80vh',
            overflow: 'auto',
            position: 'relative'
          }}>
            <CloseIcon 
              onClick={() => setShowTeacherAlarm(false)}
              style={{
                position: 'absolute',
                top: '15px',
                right: '15px',
                cursor: 'pointer',
                color: '#666'
              }}
            />

            <h2 style={{ marginBottom: '20px', color: '#333' }}>교사 알림센터</h2>

            {/* 탭 */}
            <div style={{
              display: 'flex',
              gap: '10px',
              marginBottom: '20px',
              borderBottom: '1px solid #eee'
            }}>
              <button
                onClick={() => setAlarmTab('message')}
                style={{
                  padding: '10px 20px',
                  border: 'none',
                  background: alarmTab === 'message' ? '#42a5f5' : 'transparent',
                  color: alarmTab === 'message' ? 'white' : '#666',
                  borderRadius: '10px 10px 0 0',
                  cursor: 'pointer'
                }}
              >
                퀘스트 요청 ({pendingRequests.length})
              </button>
            </div>

            {/* 퀘스트 요청 목록 */}
            {alarmTab === 'message' && (
              <div>
                {pendingRequests.length === 0 ? (
                  <p style={{ color: '#666', textAlign: 'center', padding: '20px' }}>
                    대기 중인 퀘스트 요청이 없습니다.
                  </p>
                ) : (
                  <div style={{ maxHeight: '400px', overflow: 'auto' }}>
                    {pendingRequests.map(quest => {
                      const student = students.find(s => s.id === quest.studentId);
                      const displayName = student?.name || '알 수 없음';
                      
                      return (
                        <div key={quest.id} style={{
                          border: '1px solid #ddd',
                          borderRadius: '10px',
                          padding: '15px',
                          marginBottom: '10px',
                          background: '#f9f9f9'
                        }}>
                          <div style={{
                            display: 'flex',
                            justifyContent: 'space-between',
                            alignItems: 'flex-start',
                            marginBottom: '10px'
                          }}>
                            <div>
                              <strong>{displayName}</strong>
                              <span style={{ color: '#666', fontSize: '12px', marginLeft: '10px' }}>
                                {formatTimeAgo(quest.createdAt)}
                              </span>
                            </div>
                            <span style={{
                              background: '#ff9800',
                              color: 'white',
                              padding: '2px 8px',
                              borderRadius: '10px',
                              fontSize: '12px'
                            }}>
                              {quest.exp || 10} XP
                            </span>
                          </div>
                          
                          <p style={{ margin: '10px 0', color: '#333' }}>
                            {quest.text}
                          </p>

                          <div style={{ display: 'flex', gap: '10px', marginTop: '15px' }}>
                            <Button
                              variant="contained"
                              onClick={() => handleQuestAction(quest.id, 'approve', student, quest)}
                              style={{
                                ...buttonStyle,
                                background: '#4caf50',
                                color: 'white'
                              }}
                            >
                              승인
                            </Button>
                            <Button
                              variant="outlined"
                              onClick={() => setSelectedRequest(quest)}
                              style={{
                                ...buttonStyle,
                                border: '1px solid #f44336',
                                color: '#f44336'
                              }}
                            >
                              거절
                            </Button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      )}

      {/* 퀘스트 거절 모달 */}
      {selectedRequest && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1001
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '400px'
          }}>
            <h3>퀘스트 거절</h3>
            <p>거절 사유를 입력해주세요:</p>
            <TextField
              fullWidth
              multiline
              rows={3}
              value={rejectReason}
              onChange={(e) => setRejectReason(e.target.value)}
              placeholder="거절 사유를 입력하세요..."
              style={{ marginBottom: '20px' }}
            />
            <div style={{ display: 'flex', gap: '10px', justifyContent: 'flex-end' }}>
              <Button onClick={() => setSelectedRequest(null)}>
                취소
              </Button>
              <Button
                variant="contained"
                onClick={() => handleQuestAction(selectedRequest.id, 'reject', students.find(s => s.id === selectedRequest.studentId), selectedRequest)}
                style={{ background: '#f44336', color: 'white' }}
              >
                거절
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 메시지 모달 */}
      {showMessageModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '500px'
          }}>
            <h3>선택한 학생들에게 메시지 보내기</h3>
            <p>선택된 학생: {selectedIds.length}명</p>
            <TextField
              fullWidth
              multiline
              rows={4}
              value={messageText}
              onChange={(e) => setMessageText(e.target.value)}
              placeholder="메시지를 입력하세요..."
              style={{ marginBottom: '20px' }}
            />
            <div style={{ display: 'flex', gap: '10px', justifyContent: 'flex-end' }}>
              <Button onClick={() => setShowMessageModal(false)}>
                취소
              </Button>
              <Button
                variant="contained"
                onClick={handleMessageSend}
                disabled={!messageText.trim()}
                style={{ background: '#42a5f5', color: 'white' }}
              >
                전송
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 퀘스트 모달 */}
      {showQuestModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '500px'
          }}>
            <h3>선택한 학생들에게 퀘스트 주기</h3>
            <p>선택된 학생: {selectedIds.length}명</p>
            
            <div style={{ marginBottom: '20px' }}>
              <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>
                경험치 설정:
              </label>
              <input
                type="number"
                value={questExp}
                onChange={(e) => setQuestExp(Number(e.target.value))}
                min="1"
                max="100"
                style={{
                  padding: '5px 10px',
                  border: '1px solid #ddd',
                  borderRadius: '5px',
                  width: '100px'
                }}
              />
            </div>

            <TextField
              fullWidth
              multiline
              rows={4}
              value={questText}
              onChange={(e) => setQuestText(e.target.value)}
              placeholder="퀘스트 내용을 입력하세요..."
              style={{ marginBottom: '20px' }}
            />
            <div style={{ display: 'flex', gap: '10px', justifyContent: 'flex-end' }}>
              <Button onClick={() => setShowQuestModal(false)}>
                취소
              </Button>
              <Button
                variant="contained"
                onClick={handleQuestSend}
                disabled={!questText.trim()}
                style={{ background: '#4caf50', color: 'white' }}
              >
                퀘스트 부여
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 이모지 모달 */}
      {showEmojiModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '500px'
          }}>
            <h3>선택한 학생들에게 이모지 보내기</h3>
            <p>선택된 학생: {selectedIds.length}명</p>

            <div style={{
              display: 'grid',
              gridTemplateColumns: 'repeat(6, 1fr)',
              gap: '10px',
              marginBottom: '20px'
            }}>
              {['😊', '👏', '💯', '🎉', '⭐', '🏆', '💪', '🔥', '👍', '❤️', '🌟', '🚀'].map(emoji => (
                <button
                  key={emoji}
                  onClick={() => setEmojiText(emoji)}
                  style={{
                    padding: '15px',
                    border: emojiText === emoji ? '2px solid #42a5f5' : '1px solid #ddd',
                    borderRadius: '10px',
                    background: emojiText === emoji ? '#e3f2fd' : 'white',
                    fontSize: '24px',
                    cursor: 'pointer'
                  }}
                >
                  {emoji}
                </button>
              ))}
            </div>

            <div style={{ display: 'flex', gap: '10px', justifyContent: 'flex-end' }}>
              <Button onClick={() => setShowEmojiModal(false)}>
                취소
              </Button>
              <Button
                variant="contained"
                onClick={handleEmojiSend}
                disabled={!emojiText}
                style={{ background: '#ff9800', color: 'white' }}
              >
                이모지 전송
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 게시판 선택 모달 */}
      {showBoardChoiceModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '400px'
          }}>
            <h3>게시판 옵션</h3>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '15px', marginTop: '20px' }}>
              <Button
                variant="contained"
                onClick={() => {
                  setShowBoardChoiceModal(false);
                  setShowCreateBoardModal(true);
                }}
                style={{ background: '#4caf50', color: 'white', padding: '15px' }}
              >
                새 게시판 만들기
              </Button>
              <Button
                variant="outlined"
                onClick={() => {
                  setShowBoardChoiceModal(false);
                  navigate('/boards');
                }}
                style={{ padding: '15px' }}
              >
                기존 게시판 보기
              </Button>
              <Button
                onClick={() => setShowBoardChoiceModal(false)}
                style={{ padding: '15px' }}
              >
                취소
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 새 게시판 생성 모달 */}
      {showCreateBoardModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '500px'
          }}>
            <h3>새 게시판 만들기</h3>
            <TextField
              fullWidth
              value={newBoardTitle}
              onChange={(e) => setNewBoardTitle(e.target.value)}
              placeholder="게시판 제목을 입력하세요..."
              style={{ margin: '20px 0' }}
            />
            <div style={{ display: 'flex', gap: '10px', justifyContent: 'flex-end' }}>
              <Button onClick={() => setShowCreateBoardModal(false)}>
                취소
              </Button>
              <Button
                variant="contained"
                onClick={handleCreateBoard}
                disabled={!newBoardTitle.trim()}
                style={{ background: '#4caf50', color: 'white' }}
              >
                생성
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 게시판 코드 모달 */}
      {showBoardCodeModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000
        }}>
          <div style={{
            background: 'white',
            borderRadius: '20px',
            padding: '30px',
            minWidth: '400px',
            textAlign: 'center'
          }}>
            <h3>게시판이 생성되었습니다!</h3>
            <p>게시판 코드:</p>
            <div style={{
              background: '#f5f5f5',
              padding: '20px',
              borderRadius: '10px',
              fontSize: '24px',
              fontWeight: 'bold',
              color: '#42a5f5',
              margin: '20px 0'
            }}>
              {generatedBoardCode}
            </div>
            <p style={{ color: '#666', fontSize: '14px' }}>
              이 코드를 학생들에게 알려주세요.
            </p>
            <div style={{ display: 'flex', gap: '10px', justifyContent: 'center', marginTop: '20px' }}>
              <Button
                variant="contained"
                onClick={() => navigate(`/board/${generatedBoardCode}`)}
                style={{ background: '#42a5f5', color: 'white' }}
              >
                게시판 보기
              </Button>
              <Button onClick={() => setShowBoardCodeModal(false)}>
                닫기
              </Button>
            </div>
          </div>
        </div>
      )}

      {/* 퀘스트 액션 결과 효과 */}
      {questResultEffect && (
        <div style={{
          position: 'fixed',
          top: '50%',
          left: '50%',
          transform: 'translate(-50%, -50%)',
          background: questResultEffect === '승인됨' ? 'linear-gradient(45deg, #4caf50, #81c784)' : 'linear-gradient(45deg, #f44336, #e57373)',
          color: 'white',
          padding: '30px 60px',
          borderRadius: '20px',
          fontSize: '24px',
          fontWeight: 'bold',
          zIndex: 2000,
          boxShadow: '0 8px 32px rgba(0,0,0,0.3)',
          animation: 'bounce 0.6s ease-out'
        }}>
          <div style={{ textAlign: 'center' }}>
            <div style={{ fontSize: '32px', marginBottom: '10px' }}>
              {questResultEffect === '승인됨' ? '✅' : '❌'}
            </div>
            <div>{questActionStudent}의 퀘스트</div>
            <div style={{ fontSize: '18px', opacity: 0.9 }}>"{questActionQuest}"</div>
            <div style={{ fontSize: '20px', marginTop: '10px' }}>
              {questResultEffect}!
            </div>
          </div>
        </div>
      )}

      {/* 퀴즈 모달 */}
      {showQuizModal && (
        <QuizSystem 
          onClose={() => setShowQuizModal(false)}
          collectionPrefix="teacher"
        />
      )}

      {/* 감정 대시보드 모달 */}
      {showEmotionDashboard && (
        <EmotionDashboardModal 
          onClose={() => setShowEmotionDashboard(false)}
        />
      )}

      {/* AI 분석 모달 */}
      {showAIAnalysisModal && (
        <AIAnalysisModal 
          onClose={() => setShowAIAnalysisModal(false)}
        />
      )}

      {/* 학습일지 보기 모달 */}
      {showJournalViewModal && (
        <LearningJournalViewModal 
          student={selectedStudent}
          onClose={() => setShowJournalViewModal(false)}
        />
      )}

      {/* 카드 뽑기 모달 */}
      {showCardDrawModal && (
        <CardDrawModal 
          studentIds={cardDrawStudentIds}
          onClose={() => setShowCardDrawModal(false)}
          onComplete={handleCardDrawComplete}
        />
      )}

      <style jsx>{`
        @keyframes bounce {
          0%, 20%, 50%, 80%, 100% { transform: translate(-50%, -50%) translateY(0); }
          40% { transform: translate(-50%, -50%) translateY(-30px); }
          60% { transform: translate(-50%, -50%) translateY(-15px); }
        }
      `}</style>
    </div>
  );
};

export default TeacherPage;