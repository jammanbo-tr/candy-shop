    const loadPendingRequests = async () => {
      try {
        const questCollection = collection(db, 'quests');
        const q = query(questCollection, orderBy('createdAt', 'desc'));
        const snapshot = await getDocs(q);
        
        const pendingQuests = snapshot.docs
          .map(doc => ({ id: doc.id, ...doc.data() }))
          .filter(quest => quest.status === 'pending');
        
        setPendingRequests(pendingQuests);
      } catch (error) {
        console.error('퀘스트 로딩 오류:', error);
