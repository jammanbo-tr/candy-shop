          <span style={{ color: '#666', fontSize: '14px' }}>경험치:</span>
          {[5, 10, 20, 50].map(amount => (
            <Button
              key={amount}
              variant="contained"
              onClick={() => handleExpGive(amount)}
              disabled={selectedIds.length === 0}
              style={{
                ...buttonStyle,
                fontSize: '12px',
                minWidth: '50px',
                padding: '5px 10px',
                background: selectedIds.length > 0 ? '#4caf50' : '#ccc',
